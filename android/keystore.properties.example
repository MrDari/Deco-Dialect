# Copia este archivo a "keystore.properties" (sin .example) y rellena los valores.
# NUNCA subas keystore.properties ni el .jks a git: contienen tu firma.
# Las contrasenas las elegiste al crear el keystore (ver paso del README).
storeFile=deco-dialect.jks
storePassword=TU_PASSWORD_DEL_KEYSTORE
keyAlias=decodialect
keyPassword=TU_PASSWORD_DE_LA_CLAVE
